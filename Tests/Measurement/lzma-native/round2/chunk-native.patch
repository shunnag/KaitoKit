+        let fresh = decoder.hotState
+        native.coder.input = UnsafePointer(fresh.inputBase)
+        native.coder.input_count = fresh.inputCount
+        native.coder.input_position = fresh.inputPosition
+        config.has_more_input = decoder.hasUnreadSource ? 1 : 0
