+private func decodeLZMAChunkNative(
+    probabilities: UnsafeMutablePointer<UInt16>, dictionary: UnsafeMutablePointer<UInt8>,
+    dictionaryCount: Int, destination: UnsafeMutablePointer<UInt8>, capacity: Int,
+    group: UnsafeMutablePointer<UInt64>, groupLimit: Int, outputLimit: UInt64?,
+    contextShift: UInt64, previousShift: UInt8, literalMask: UInt64, positionMask: UInt64,
+    decoder: inout LZMARangeDecoder, window: inout LZMAWindowCursor,
